    "# 1. Gastos totales por fuente \n",
    "costs_by_source = costs.groupby('source_id')['costs'].sum().reset_index()\n",
    "\n",
    "plt.figure(figsize=(8, 4))\n",
    "sns.barplot(data=costs_by_source, x='source_id', y='costs', palette='RdPu_r')\n",
    "plt.title('Gastos Totales por Fuente de Adquisición')\n",
    "plt.xlabel('ID de Fuente de Anuncios')\n",
    "plt.ylabel('Gasto Total ($)')\n",
    "plt.show()\n",
    "\n",
    "# 2. Cálculo del CAC por Cohorte\n",
    "costs['month'] = costs['dt'].astype('datetime64[M]')\n",
    "monthly_costs = costs.groupby('month')['costs'].sum().reset_index()\n",
    "\n",
    "report_cac = pd.merge(report, monthly_costs, left_on='first_order_month', right_on='month')\n",
    "report_cac['cac'] = report_cac['costs'] / report_cac['n_buyers']\n",
    "\n",
    "# 3. ROMI Acumulado\n",
    "report_cac['romi'] = report_cac['ltv'] / report_cac['cac']\n",
