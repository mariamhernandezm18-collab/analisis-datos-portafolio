    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Configuración visual\n",
    "sns.set_theme(style='whitegrid')\n",
    "plt.rcParams['figure.figsize'] = (10, 5)\n",
    "\n",
    "# Carga de datasets \n",
    "visits = pd.read_csv('/datasets/visits_log_us.csv')\n",
    "orders = pd.read_csv('/datasets/orders_log_us.csv')\n",
    "costs = pd.read_csv('/datasets/costs_us.csv')\n",
    "\n",
    "# Renombrar columnas para estandarizar en minúsculas y facilitar la manipulación\n",
    "visits.columns = visits.columns.str.lower().str.replace(' ', '_')\n",
    "orders.columns = orders.columns.str.lower().str.replace(' ', '_')\n",
    "costs.columns = costs.columns.str.lower().str.replace(' ', '_')\n",
    "\n",
    "# Conversión a tipos datetime\n",
    "visits['start_ts'] = pd.to_datetime(visits['start_ts'])\n",
    "visits['end_ts'] = pd.to_datetime(visits['end_ts'])\n",
    "orders['buy_ts'] = pd.to_datetime(orders['buy_ts'])\n",
    "costs['dt'] = pd.to_datetime(costs['dt'])\n",
    "\n",
    "# Extracción de dimensiones temporales en la tabla visits\n",
    "visits['start_date'] = visits['start_ts'].dt.date\n",
    "visits['start_week'] = visits['start_ts'].dt.isocalendar().week\n",
    "visits['start_month'] = visits['start_ts'].dt.month\n",
    "visits['start_year'] = visits['start_ts'].dt.year\n",
    "\n",
    "# Revisar los primeros registros y tipos de datos\n",
    "print(\"Visitas:\")\n",
    "print(visits.info())\n",
    "print(\"\\nPedidos:\")\n",
    "print(orders.info())\n",
    "print(\"\\nGastos:\")\n",
    "print(costs.info())"
