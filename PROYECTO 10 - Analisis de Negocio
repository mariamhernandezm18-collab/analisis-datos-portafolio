    "# 1. Tiempo hasta la conversión\n",
    "first_visits = visits.groupby('uid')['start_ts'].min().reset_index()\n",
    "first_visits.columns = ['uid', 'first_visit_ts']\n",
    "\n",
    "first_orders = orders.groupby('uid')['buy_ts'].min().reset_index()\n",
    "first_orders.columns = ['uid', 'first_order_ts']\n",
    "\n",
    "conversion_df = pd.merge(first_orders, first_visits, on='uid')\n",
    "conversion_df['days_to_conversion'] = (\n",
    "    conversion_df['first_order_ts'] - conversion_df['first_visit_ts']\n",
    ").dt.total_seconds() / (24 * 3600)\n",
    "\n",
    "print(\"Días transcurridos hasta la primera compra:\")\n",
    "print(conversion_df['days_to_conversion'].describe())\n",
    "\n",
    "# 2. Pedidos y Ticket Promedio\n",
    "orders_per_user = orders.groupby('uid').agg({'buy_ts': 'count', 'revenue': 'sum'})\n",
    "print(f\"\\nPedidos promedio por comprador: {orders_per_user['buy_ts'].mean():.2f}\")\n",
    "print(f\"Tamaño promedio de compra (Ticket promedio): ${orders['revenue'].mean():.2f}\")\n",
    "\n",
    "# 3. Cohortes de LTV\n",
    "orders['order_month'] = orders['buy_ts'].astype('datetime64[M]')\n",
    "\n",
    "first_buy = orders.groupby('uid')['order_month'].min().reset_index()\n",
    "first_buy.columns = ['uid', 'first_order_month']\n",
    "\n",
    "cohort_sizes = first_buy.groupby('first_order_month').agg({'uid': 'nunique'}).reset_index()\n",
    "cohort_sizes.columns = ['first_order_month', 'n_buyers']\n",
    "\n",
    "orders_cohorts = pd.merge(orders, first_buy, on='uid')\n",
    "\n",
    "report = orders_cohorts.groupby(['first_order_month', 'order_month']).agg({'revenue': 'sum'}).reset_index()\n",
    "report = pd.merge(cohort_sizes, report, on='first_order_month')\n",
    "\n",
    "report['age'] = ((report['order_month'] - report['first_order_month']) / np.timedelta64(1, 'M')).round().astype(int)\n",
    "report['ltv'] = report['revenue'] / report['n_buyers']\n",
    "\n",
    "ltv_pivot = report.pivot_table(\n",
    "    index='first_order_month', \n",
    "    columns='age', \n",
    "    values='ltv', \n",
    "    aggfunc='sum'\n",
    ").cumsum(axis=1)\n",
    "\n",
    "# Mapa de calor de LTV \n",
    "plt.figure(figsize=(12, 6))\n",
    "sns.heatmap(ltv_pivot, annot=True, fmt='.2f', cmap='PuRd')\n",
    "plt.title('LTV Acumulado por Cohorte Mensual ($)')\n",
    "plt.xlabel('Edad de la Cohorte (Meses)')\n",
    "plt.ylabel('Mes de la Cohorte')\n",
    "plt.show()"
   ]
