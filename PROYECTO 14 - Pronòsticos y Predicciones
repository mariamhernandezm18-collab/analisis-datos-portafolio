    "# Separación de variables y división train/test\n",
    "X = df.drop('churn', axis=1)\n",
    "y = df['churn']\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=0.2, random_state=0\n",
    ")\n",
    "\n",
    "# Estandarización\n",
    "scaler = StandardScaler()\n",
    "X_train_st = scaler.fit_transform(X_train)\n",
    "X_test_st = scaler.transform(X_test)\n",
    "\n",
    "\n",
    "# Función para evaluar métricas\n",
    "def evaluate_model(model, X_tr, y_tr, X_te, y_te, name):\n",
    "    model.fit(X_tr, y_tr)\n",
    "    preds = model.predict(X_te)\n",
    "    print(f'=== {name} ===')\n",
    "    print(f'Accuracy:  {accuracy_score(y_te, preds):.2f}')\n",
    "    print(f'Precision: {precision_score(y_te, preds):.2f}')\n",
    "    print(f'Recall:    {recall_score(y_te, preds):.2f}\\n')\n",
    "\n",
    "\n",
    "# Regresión Logística\n",
    "lr_model = LogisticRegression(random_state=0)\n",
    "evaluate_model(\n",
    "    lr_model, X_train_st, y_train, X_test_st, y_test, 'Regresión Logística'\n",
    ")\n",
    "\n",
    "# Bosque Aleatorio\n",
    "rf_model = RandomForestClassifier(random_state=0)\n",
    "evaluate_model(\n",
    "    rf_model, X_train_st, y_train, X_test_st, y_test, 'Bosque Aleatorio'\n",
    ")"
