   "source": [
    "# 1. Definir los eventos principales del embudo (excluyendo eventos secundarios si aplican)\n",
    "funnel_stages = ['login', 'product_page', 'product_cart', 'purchase']\n",
    "\n",
    "# 2. Conteo de usuarios únicos por etapa y grupo\n",
    "funnel_data = []\n",
    "\n",
    "for group in ['A', 'B']:\n",
    "    group_users = rec_events[rec_events['group'] == group]\n",
    "    total_group_users = rec_users[rec_users['group'] == group]['user_id'].nunique()\n",
    "    \n",
    "    for stage in funnel_stages:\n",
    "        stage_users = group_users[group_users['event_name'] == stage]['user_id'].nunique()\n",
    "        conversion = stage_users / total_group_users\n",
    "        funnel_data.append({\n",
    "            'group': group,\n",
    "            'stage': stage,\n",
    "            'users': stage_users,\n",
    "            'total_users': total_group_users,\n",
    "            'conversion': conversion\n",
    "        })\n",
    "\n",
    "df_funnel = pd.DataFrame(funnel_data)\n",
    "\n",
    "# 3. Gráfico de Embudo por Grupo \n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.barplot(data=df_funnel, x='stage', y='conversion', hue='group', palette=['#ff85a1', '#b5179e'])\n",
    "plt.title('Conversión por Etapa del Embudo (Proporción respecto al total)', fontsize=12, fontweight='bold')\n",
    "plt.xlabel('Etapa del Embudo')\n",
    "plt.ylabel('Tasa de Conversión')\n",
    "plt.ylim(0, 1)\n",
    "\n",
    "for p in plt.gca().patches:\n",
    "    height = p.get_height()\n",
    "    if height > 0:\n",
    "        plt.gca().annotate(f'{height:.1%}',\n",
    "                    (p.get_x() + p.get_width() / 2., height),\n",
    "                    ha='center', va='bottom',\n",
    "                    fontsize=9, color='black',\n",
    "                    xytext=(0, 3),\n",
    "                    textcoords='offset points')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# 4. Pruebas Z de proporciones entre Grupo A y Grupo B para cada etapa\n",
    "def z_test_proportions(count1, nobs1, count2, nobs2):\n",
    "    p1 = count1 / nobs1\n",
    "    p2 = count2 / nobs2\n",
    "    p_combined = (count1 + count2) / (nobs1 + nobs2)\n",
    "    difference = p1 - p2\n",
    "    \n",
    "    z_value = difference / np.sqrt(p_combined * (1 - p_combined) * (1/nobs1 + 1/nobs2))\n",
    "    p_value = (1 - stats.norm.cdf(abs(z_value))) * 2\n",
    "    return z_value, p_value\n",
    "\n",
    "print(\"--- RESULTADOS DE LA PRUEBA Z DE PROPORCIONES ---\")\n",
    "for stage in funnel_stages:\n",
    "    a_data = df_funnel[(df_funnel['group'] == 'A') & (df_funnel['stage'] == stage)].iloc[0]\n",
    "    b_data = df_funnel[(df_funnel['group'] == 'B') & (df_funnel['stage'] == stage)].iloc[0]\n",
    "    \n",
    "    z_val, p_val = z_test_proportions(a_data['users'], a_data['total_users'], \n",
    "                                     b_data['users'], b_data['total_users'])\n",
    "    \n",
    "    print(f\"Etapa: {stage:<15} | p-value: {p_val:.4f} | {'Diferencia Significativa' if p_val < 0.05 else 'Sin Diferencia'}\")"
