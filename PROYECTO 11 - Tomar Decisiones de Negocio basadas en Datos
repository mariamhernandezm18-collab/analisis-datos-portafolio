    "# 1. PREPARACIÓN DE DATOS ACUMULADOS (CELDA [4])\n",
    "datesGroups = orders_clean[['date', 'group']].drop_duplicates()\n",
    "\n",
    "ordersAggregated = datesGroups.apply(\n",
