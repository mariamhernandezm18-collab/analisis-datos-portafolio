    "import pandas as pd\n",
    "\n",
    "# 1. Cargar el dataset especificando el separador correcto (punto y coma)\n",
    "hypotheses = pd.read_csv('/datasets/hypotheses_us.csv', sep=';')\n",
    "\n",
    "# 2. Convertir los nombres de las columnas a minúsculas\n",
    "hypotheses.columns = hypotheses.columns.str.lower()\n",
    "\n",
    "# 3. Calcular marco ICE\n",
    "hypotheses['ice'] = (hypotheses['impact'] * hypotheses['confidence']) / hypotheses['effort']\n",
    "\n",
    "# 4. Calcular marco RICE\n",
    "hypotheses['rice'] = (hypotheses['reach'] * hypotheses['impact'] * hypotheses['confidence']) / hypotheses['effort']\n",
    "\n",
    "# 5. Mostrar priorización ICE\n",
    "print(\"=== PRIORIZACIÓN ICE ===\")\n",
    "display(hypotheses[['hypothesis', 'ice']].sort_values(by='ice', ascending=False))\n",
    "\n",
    "# 6. Mostrar priorización RICE\n",
    "print(\"\\n=== PRIORIZACIÓN RICE ===\")\n",
    "display(hypotheses[['hypothesis', 'rice']].sort_values(by='rice', ascending=False))"
