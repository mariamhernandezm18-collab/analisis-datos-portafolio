    "# Calcula el ingreso mensual para cada usuario\n",
    "\n",
    "# 1. Exceso de minutos\n",
    "df_final['extra_min'] = df_final['minutes_sum'] - df_final['minutes_included']\n",
    "df_final['extra_min_cost'] = np.where(df_final['extra_min'] > 0, df_final['extra_min'] * df_final['usd_per_minute'], 0)\n",
    "\n",
    "# 2. Exceso de mensajes\n",
    "df_final['extra_msg'] = df_final['messages_count'] - df_final['messages_included']\n",
    "df_final['extra_msg_cost'] = np.where(df_final['extra_msg'] > 0, df_final['extra_msg'] * df_final['usd_per_message'], 0)\n",
    "\n",
    "# 3. Exceso de internet (Corregido: conversión a GB total primero, luego cálculo de excedente)\n",
    "df_final['gb_used_ceil'] = np.ceil(df_final['mb_used_sum'] / 1024)\n",
    "df_final['extra_gb'] = df_final['gb_used_ceil'] - (df_final['mb_per_month_included'] / 1024)\n",
    "df_final['extra_net_cost'] = np.where(df_final['extra_gb'] > 0, df_final['extra_gb'] * df_final['usd_per_gb'], 0)\n",
    "\n",
    "# 4. Ingreso Total = Costo Fijo Mensual + Costos Extras por excedentes\n",
    "df_final['total_revenue'] = df_final['usd_monthly_pay'] + df_final['extra_min_cost'] + df_final['extra_msg_cost'] + df_final['extra_net_cost']\n",
    "\n",
    "# Mostrar una muestra del resultado final con el ingreso calculado\n",
    "df_final[['user_id', 'month', 'plan', 'minutes_sum', 'messages_count', 'mb_used_sum', 'total_revenue']].head()"
