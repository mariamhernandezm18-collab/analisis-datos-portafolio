   "source": [
    "# Prueba las hipótesis\n",
    "from scipy import stats as st\n",
    "\n",
    "# Filtrar los ingresos por plan\n",
    "revenue_surf = df_final[df_final['plan'] == 'surf']['total_revenue']\n",
    "revenue_ultimate = df_final[df_final['plan'] == 'ultimate']['total_revenue']\n",
    "\n",
    "# Definir nivel de significancia\n",
    "alpha = 0.05\n",
    "\n",
    "# Ejecutar la prueba T para muestras independientes con varianzas desiguales\n",
    "results = st.ttest_ind(revenue_surf, revenue_ultimate, equal_var=False)\n",
    "\n",
    "print('Valor p:', results.pvalue)\n",
    "\n",
    "if results.pvalue < alpha:\n",
    "    print(\"Rechazamos la hipótesis nula: El ingreso promedio entre los planes es diferente.\")\n",
    "else:\n",
    "    print(\"No podemos rechazar la hipótesis nula: No hay evidencia suficiente para decir que los ingresos promedio son diferentes.\")\n"
