    "# ==============================================================================\n",
    "# PASO 5.1: PRUEBA DE HIPÓTESIS 1 - XBOX ONE VS. PC\n",
    "# ==============================================================================\n",
    "\n",
    "from scipy import stats as st\n",
    "\n",
    "print(\"--- Prueba de Hipótesis 1: Xbox One vs. PC (User Score) ---\")\n",
