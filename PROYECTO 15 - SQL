    "    COUNT(b.book_id) AS total_books\n",
    "FROM books b\n",
    "JOIN publishers p ON b.publisher_id = p.publisher_id\n",
    "WHERE b.num_pages > 50\n",
    "GROUP BY p.publisher\n",
    "ORDER BY total_books DESC\n",
    "LIMIT 1;\n",
