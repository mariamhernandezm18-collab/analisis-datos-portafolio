    "query_4 = \"\"\"\n",
    "WITH popular_books AS (\n",
    "    SELECT book_id\n",
    "    FROM ratings\n",
    "    GROUP BY book_id\n",
    "    HAVING COUNT(rating_id) >= 50\n",
    ")\n",
    "SELECT \n",
    "    a.author,\n",
    "    ROUND(AVG(r.rating), 2) AS avg_author_rating\n",
    "FROM ratings r\n",
    "JOIN books b ON r.book_id = b.book_id\n",
    "JOIN authors a ON b.author_id = a.author_id\n",
    "WHERE b.book_id IN (SELECT book_id FROM popular_books)\n",
    "GROUP BY a.author\n",
    "ORDER BY avg_author_rating DESC\n",
    "LIMIT 1;\n",
    "\"\"\"\n",
    "run_query(query_4)"
   ]
