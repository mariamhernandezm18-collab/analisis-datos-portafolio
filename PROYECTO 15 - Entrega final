    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from scipy import stats\n",
    "\n",
    "# Carga de datos de Telecomunicaciones\n",
    "telecom_df = pd.read_csv('/datasets/telecom_dataset_us.csv')\n",
    "clients_df = pd.read_csv('/datasets/telecom_clients_us.csv')\n",
    "\n",
    "# Inspección inicial y limpieza de tipos de datos\n",
    "telecom_df['date'] = pd.to_datetime(telecom_df['date'])\n",
    "clients_df['date_start'] = pd.to_datetime(clients_df['date_start'])\n",
    "\n",
    "# Eliminación de nulos críticos en operator_id para el análisis individual\n",
    "telecom_clean = telecom_df.dropna(subset=['operator_id']).copy()\n",
    "telecom_clean['operator_id'] = telecom_clean['operator_id'].astype(int)\n",
    "\n",
    "# Cálculo del tiempo de espera (total_call_duration - call_duration)\n",
    "telecom_clean['wait_time'] = telecom_clean['total_call_duration'] - telecom_clean['call_duration']\n",
    "telecom_clean['wait_time'] = telecom_clean['wait_time'].apply(lambda x: max(x, 0))\n",
    "\n",
    "print(\"Registros limpios cargados:\", len(telecom_clean))\n",
    "print(\"Operadores únicos identificados:\", telecom_clean['operator_id'].nunique())"
   ]
